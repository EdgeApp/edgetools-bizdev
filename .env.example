# Copy to .env for local dev (never commit .env). In production these are set
# as App Platform environment variables (mark both as "encrypted/secret").

# Shared staff password for the login gate. Leave empty and NO ONE can log in.
STAFF_PASSWORD=change-me-to-a-strong-shared-password

# Secret used to sign the session cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Port is provided by App Platform automatically; only needed for local dev.
PORT=8080
